@model List<HotelBooking.Business.DTOs.Block.BlockDto>
@{
    var hotel = (HotelBooking.Business.DTOs.Hotels.HotelDto)ViewData["Hotel"]!;
    ViewData["Title"] = "Bloques";
}
<nav aria-label="breadcrumb"><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-controller="Hotels" asp-action="Index">Hoteles</a></li>
    <li class="breadcrumb-item active">@hotel.Name</li>
</ol></nav>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Bloques de @hotel.Name</h1>
    <a asp-action="Create" asp-route-hotelId="@hotel.Id" class="btn btn-primary">Nuevo bloque</a>
</div>
<table class="table table-striped bg-white align-middle">
    <thead><tr><th>Nombre</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
    <tbody>
    @foreach (var b in Model)
    {
        <tr>
            <td>@b.Name</td>
            <td><span class="badge bg-@(b.IsActive ? "success" : "secondary")">@(b.IsActive ? "Activo" : "Inactivo")</span></td>
            <td class="text-end">
                <a asp-controller="Floors" asp-action="Index" asp-route-blockId="@b.Id" class="btn btn-sm btn-outline-dark">Pisos</a>
                <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                <form asp-action="SetActive" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@b.Id" />
                    <input type="hidden" name="hotelId" value="@hotel.Id" />
                    <input type="hidden" name="isActive" value="@((!b.IsActive).ToString().ToLower())" />
                    <button class="btn btn-sm btn-outline-@(b.IsActive ? "danger" : "success")">@(b.IsActive ? "Desactivar" : "Activar")</button>
                </form>
            </td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="3" class="text-center text-muted">Este hotel no tiene bloques.</td></tr> }
    </tbody>
</table>
