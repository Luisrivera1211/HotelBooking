@model FloorFormViewModel
<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<form asp-action="Create" method="post" class="card card-body shadow-sm" style="max-width:600px">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input asp-for="BlockId" type="hidden" />
    <div class="mb-3">
        <label asp-for="Number" class="form-label">Número de piso</label>
        <input asp-for="Number" class="form-control" type="number" min="1" />
        <span asp-validation-for="Number" class="text-danger"></span>
    </div>
    <div><button class="btn btn-primary">Guardar</button> <a asp-action="Index" asp-route-blockId="@Model.BlockId" class="btn btn-link">Cancelar</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
