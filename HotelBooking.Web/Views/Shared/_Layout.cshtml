@{
    var auth = User.Identity?.IsAuthenticated == true;
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    string Act(string c) => ctrl == c ? " active" : "";
    var isAdmin = User.IsInRole(Roles.Administrator);
    var name = User.Identity?.Name ?? "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HotelBooking</title>
    <link rel="icon" type="image/svg+xml" href="~/img/logo-mark.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600&family=Spectral:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/hotel-theme.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="app-body">
@if (auth)
{
    <div class="app-shell">
        <aside class="app-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="sidebar" aria-label="Menú principal">
            <div class="offcanvas-body">
                <div class="sidebar-inner">
                    <a class="side-brand" asp-controller="Home" asp-action="Index">
                        <img src="~/img/logo-mark.svg" alt="" width="44" height="44" />
                        <span>HotelBooking<small>Gestión hotelera</small></span>
                    </a>
                    <nav class="side-nav">
                        <a class="side-link@(Act("Home"))" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i>Inicio</a>
                        <a class="side-link@(Act("Availability"))" asp-controller="Availability" asp-action="Index"><i class="bi bi-calendar-check"></i>Disponibilidad</a>
                        <a class="side-link@(Act("Guests"))" asp-controller="Guests" asp-action="Index"><i class="bi bi-people"></i>Huéspedes</a>
                        @if (isAdmin)
                        {
                            <div class="side-section">Administración</div>
                            <a class="side-link@(Act("Hotels"))" asp-controller="Hotels" asp-action="Index"><i class="bi bi-buildings"></i>Hoteles</a>
                            <a class="side-link@(Act("RoomTypes"))" asp-controller="RoomTypes" asp-action="Index"><i class="bi bi-door-open"></i>Tipos de habitación</a>
                        }
                    </nav>
                    <div class="side-foot">© @DateTime.Now.Year HotelBooking</div>
                </div>
            </div>
        </aside>

        <div class="app-content">
            <header class="app-topbar">
                <button class="btn btn-outline-dark btn-sm d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-label="Abrir menú"><i class="bi bi-list"></i></button>
                <div class="ms-auto d-flex align-items-center gap-3">
                    <div class="user-chip">
                        <span class="avatar">@(name.Length > 0 ? name[..1].ToUpper() : "?")</span>
                        <span class="d-none d-sm-block lh-sm">@name<small>@(isAdmin ? "Administrador" : "Recepcionista")</small></span>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-dark btn-sm"><i class="bi bi-box-arrow-right me-1"></i>Salir</button>
                    </form>
                </div>
            </header>
            <main class="app-main">
                <div class="app-main-inner">
                    <partial name="_Alerts" />
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>
}
else
{
    <nav class="navbar app-nav mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="~/img/logo-mark.svg" alt="" width="34" height="34" />
                <span>HotelBooking</span>
            </a>
        </div>
    </nav>
    <main class="container pb-5">
        <partial name="_Alerts" />
        @RenderBody()
    </main>
}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
