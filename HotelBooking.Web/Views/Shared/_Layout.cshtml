<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HotelBooking</title>
    <link rel="icon" type="image/svg+xml" href="~/img/logo-mark.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600&family=Spectral:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/hotel-theme.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="app-body">
@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    var isGuest = User.IsGuest();
    var isAdmin = User.IsInRole(Roles.Administrator);
    var roleText = isAdmin ? "Administrador" : isGuest ? "Huésped" : "Recepcionista";
}
<nav class="navbar navbar-expand-lg app-nav mb-4">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            <img src="~/img/logo-mark.svg" alt="" width="34" height="34" />
            <span>HotelBooking</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-label="Abrir menú">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="menu">
            <ul class="navbar-nav me-auto">
                @* Todos, incluso el visitante *@
                <li class="nav-item"><a class="nav-link" asp-controller="Availability" asp-action="Index">Disponibilidad</a></li>

                @* Huésped con cuenta *@
                @if (isAuth && isGuest)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Reservations" asp-action="Mine">Mis reservas</a></li>
                }

                @* Recepcionista y administrador *@
                @if (isAuth && !isGuest)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Guests" asp-action="Index">Huéspedes</a></li>
                }

                @* Solo administrador *@
                @if (isAdmin)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Hotels" asp-action="Index">Hoteles</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="RoomTypes" asp-action="Index">Tipos de habitación</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Audit" asp-action="Index">Auditoría</a></li>
                }
            </ul>
            @if (isAuth)
            {
                <span class="navbar-text me-3">
                    @User.Identity!.Name
                    <span class="badge bg-secondary">@roleText</span>
                </span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-dark btn-sm">Cerrar sesión</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-dark btn-sm me-2">Iniciar sesión</a>
                <a asp-controller="Account" asp-action="RegisterGuest" class="btn btn-primary btn-sm">Crear cuenta</a>
            }
        </div>
    </div>
</nav>

<main class="container pb-5">
    <partial name="_Alerts" />
    @RenderBody()
</main>

<footer class="app-footer">
    <div class="container">© @DateTime.Now.Year HotelBooking</div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
