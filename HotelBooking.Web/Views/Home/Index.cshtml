@model DashboardViewModel
@{
    var firstName = (User.Identity!.Name ?? "").Split(' ')[0];
}
<div class="welcome-hero mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <h1>Bienvenido, @firstName</h1>
        <p>Resumen de la operación de hoy.</p>
    </div>
    <a asp-controller="Availability" asp-action="Index" class="btn btn-light">Buscar habitaciones</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card app-card h-100">
            <div class="card-body">
                <div class="text-muted small">Hoteles activos</div>
                <div class="stat-value">@Model.ActiveHotels</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card app-card h-100">
            <div class="card-body">
                <div class="text-muted small">Huéspedes</div>
                <div class="stat-value">@Model.Guests</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card app-card h-100">
            <div class="card-body">
                <div class="text-muted small">Reservas próximas</div>
                <div class="stat-value">@Model.UpcomingCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card app-card h-100">
            <div class="card-body">
                <div class="text-muted small">Pendientes de confirmar</div>
                <div class="stat-value">@Model.PendingCount</div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="h5 mb-0">Próximas reservas</h2>
</div>
<div class="table-responsive">
    <table class="table table-striped bg-white align-middle">
        <thead><tr><th>#</th><th>Huésped</th><th>Habitación</th><th>Entrada</th><th>Salida</th><th>Estado</th><th></th></tr></thead>
        <tbody>
            @foreach (var r in Model.Upcoming)
            {
                <tr>
                    <td>@r.Id</td>
                    <td>@r.GuestName</td>
                    <td>@r.RoomNumber</td>
                    <td>@r.CheckIn.ToString("dd/MM/yyyy")</td>
                    <td>@r.CheckOut.ToString("dd/MM/yyyy")</td>
                    <td><span class="badge bg-@r.Status.Badge()">@r.Status.Text()</span></td>
                    <td class="text-end"><a asp-controller="Reservations" asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-dark">Ver</a></td>
                </tr>
            }
            @if (!Model.Upcoming.Any())
            {
                <tr><td colspan="7" class="text-center text-muted">No hay reservas próximas.</td></tr>
            }
        </tbody>
    </table>
</div>
