@if (User.Identity?.IsAuthenticated != true)
{
    <div class="card app-card p-4 p-md-5 mb-4 shadow-sm text-center">
        <h1 class="display-6">Encuentre su habitación</h1>
        <p class="lead text-muted">Busque entre nuestros hoteles sin necesidad de cuenta. La cuenta solo se pide al reservar.</p>
        <a asp-controller="Availability" asp-action="Index" class="btn btn-primary btn-lg">Buscar habitaciones</a>
        <div class="mt-3">
            <a asp-controller="Account" asp-action="Login" class="btn btn-link">Iniciar sesión</a>
            <a asp-controller="Account" asp-action="RegisterGuest" class="btn btn-link">Crear cuenta</a>
        </div>
    </div>
}
else
{
    <h1 class="h3 mb-4">Bienvenido, @User.Identity!.Name</h1>
    <div class="row g-3">
        <div class="col-md-4">
            <div class="card h-100 app-card"><div class="card-body">
                <h2 class="h5">Disponibilidad</h2>
                <p class="text-muted">Busque habitaciones libres por fechas y cree la reserva.</p>
                <a asp-controller="Availability" asp-action="Index" class="btn btn-primary">Buscar</a>
            </div></div>
        </div>
        @if (User.IsGuest())
        {
            <div class="col-md-4">
                <div class="card h-100 app-card"><div class="card-body">
                    <h2 class="h5">Mis reservas</h2>
                    <p class="text-muted">Consulte, modifique o cancele sus reservas.</p>
                    <a asp-controller="Reservations" asp-action="Mine" class="btn btn-primary">Ver mis reservas</a>
                </div></div>
            </div>
        }
        else
        {
            <div class="col-md-4">
                <div class="card h-100 app-card"><div class="card-body">
                    <h2 class="h5">Huéspedes</h2>
                    <p class="text-muted">Registre huéspedes y consulte sus reservas.</p>
                    <a asp-controller="Guests" asp-action="Index" class="btn btn-primary">Ver huéspedes</a>
                </div></div>
            </div>
        }
        @if (User.IsInRole(Roles.Administrator))
        {
            <div class="col-md-4">
                <div class="card h-100 app-card"><div class="card-body">
                    <h2 class="h5">Administración</h2>
                    <p class="text-muted">Hoteles, bloques, pisos, habitaciones y tipos.</p>
                    <a asp-controller="Hotels" asp-action="Index" class="btn btn-dark">Hoteles</a>
                    <a asp-controller="RoomTypes" asp-action="Index" class="btn btn-outline-dark">Tipos</a>
                    <a asp-controller="Audit" asp-action="Index" class="btn btn-outline-dark">Auditoría</a>
                </div></div>
            </div>
        }
    </div>
}
