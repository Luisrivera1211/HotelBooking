@if (User.Identity?.IsAuthenticated != true)
{
    <div class="card app-card p-4 p-md-5 mb-4 shadow-sm text-center">
        <h1 class="display-6">Encuentre su habitación</h1>
        <p class="lead text-muted">Busque entre nuestros hoteles sin necesidad de cuenta. La cuenta solo se pide al reservar.</p>
        <div><a asp-controller="Availability" asp-action="Index" class="btn btn-primary btn-lg">Buscar habitaciones</a></div>
        <div class="mt-3">
            <a asp-controller="Account" asp-action="Login" class="btn btn-link">Iniciar sesión</a>
            <a asp-controller="Account" asp-action="RegisterGuest" class="btn btn-link">Crear cuenta</a>
        </div>
    </div>
}
else
{
    <h1 class="h3 mb-4">Bienvenido, @User.Identity!.Name</h1>
    <div class="row g-3">
        <div class="col-md-4">
            <div class="card h-100 app-card">
                <div class="card-body">
                    <h2 class="h5">Disponibilidad</h2>
                    <p class="text-muted">Busque habitaciones libres por fechas y haga su reserva.</p>
                    <a asp-controller="Availability" asp-action="Index" class="btn btn-primary">Buscar</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 app-card">
                <div class="card-body">
                    <h2 class="h5">Mis reservas</h2>
                    <p class="text-muted">Consulte, modifique o cancele sus reservas.</p>
                    <a asp-controller="Reservations" asp-action="Mine" class="btn btn-primary">Ver mis reservas</a>
                </div>
            </div>
        </div>
    </div>
}
