@if (User.Identity?.IsAuthenticated != true)
{
    <div class="welcome-hero mb-4 text-center py-5">
        <h1>Encuentre su habitación</h1>
        <p class="mb-4">Busque entre nuestros hoteles sin necesidad de cuenta. La cuenta solo se pide al reservar.</p>
        <a asp-controller="Availability" asp-action="Index" class="btn btn-light btn-lg">Buscar habitaciones</a>
        <div class="mt-3">
            <a asp-controller="Account" asp-action="Login" class="btn btn-link text-white">Iniciar sesión</a>
            <a asp-controller="Account" asp-action="RegisterGuest" class="btn btn-link text-white">Crear cuenta</a>
        </div>
    </div>
}
else
{
    <div class="welcome-hero mb-4">
        <h1>Bienvenido, @((User.Identity!.Name ?? "").Split(' ')[0])</h1>
        <p>Encuentre su habitación y administre sus reservas.</p>
    </div>
    <div class="row g-3">
        <div class="col-md-4">
            <div class="card h-100 app-card">
                <div class="card-body">
                    <h2 class="h5">Disponibilidad</h2>
                    <p class="text-muted">Busque habitaciones libres por fechas y haga su reserva.</p>
                    <a asp-controller="Availability" asp-action="Index" class="btn btn-primary">Buscar</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 app-card">
                <div class="card-body">
                    <h2 class="h5">Mis reservas</h2>
                    <p class="text-muted">Consulte, modifique o cancele sus reservas.</p>
                    <a asp-controller="Reservations" asp-action="Mine" class="btn btn-primary">Ver mis reservas</a>
                </div>
            </div>
        </div>
    </div>
}
