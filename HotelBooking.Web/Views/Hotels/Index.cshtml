@model List<HotelBooking.Business.DTOs.Hotels.HotelDto>
@{ ViewData["Title"] = "Hoteles"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Hoteles</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo hotel</a>
</div>
<table class="table table-striped bg-white align-middle">
    <thead><tr><th>Nombre</th><th>Dirección</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
    <tbody>
    @foreach (var h in Model)
    {
        <tr>
            <td>@h.Name</td>
            <td>@h.Address</td>
            <td><span class="badge bg-@(h.IsActive ? "success" : "secondary")">@(h.IsActive ? "Activo" : "Inactivo")</span></td>
            <td class="text-end">
                <a asp-controller="Blocks" asp-action="Index" asp-route-hotelId="@h.Id" class="btn btn-sm btn-outline-dark">Bloques</a>
                <a asp-action="Edit" asp-route-id="@h.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                <form asp-action="SetActive" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@h.Id" />
                    <input type="hidden" name="isActive" value="@((!h.IsActive).ToString().ToLower())" />
                    <button class="btn btn-sm btn-outline-@(h.IsActive ? "danger" : "success")">@(h.IsActive ? "Desactivar" : "Activar")</button>
                </form>
            </td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="4" class="text-center text-muted">No hay hoteles registrados.</td></tr> }
    </tbody>
</table>
