@model GuestDetailsViewModel
@{ ViewData["Title"] = Model.Guest.FullName; }
<nav aria-label="breadcrumb"><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-action="Index">Huéspedes</a></li>
    <li class="breadcrumb-item active">@Model.Guest.FullName</li>
</ol></nav>
<div class="card card-body shadow-sm mb-4">
    <div class="d-flex justify-content-between">
        <div>
            <h1 class="h4">@Model.Guest.FullName</h1>
            <div>Documento: @Model.Guest.Document</div>
            <div>Correo: @Model.Guest.Email</div>
            <div>Teléfono: @Model.Guest.Phone</div>
        </div>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Guest.Id" class="btn btn-outline-primary btn-sm">Editar</a>
            <a asp-controller="Availability" asp-action="Index" class="btn btn-primary btn-sm">Nueva reserva</a>
        </div>
    </div>
</div>
<h2 class="h5">Reservas</h2>
<table class="table table-striped bg-white align-middle">
    <thead><tr><th>#</th><th>Habitación</th><th>Entrada</th><th>Salida</th><th>Total</th><th>Estado</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model.Reservations)
    {
        <tr>
            <td>@r.Id</td><td>@r.RoomNumber</td>
            <td>@r.CheckIn.ToString("dd/MM/yyyy")</td><td>@r.CheckOut.ToString("dd/MM/yyyy")</td>
            <td>@r.Total.ToString("C")</td>
            <td><span class="badge bg-@r.Status.Badge()">@r.Status.Text()</span></td>
            <td class="text-end"><a asp-controller="Reservations" asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-dark">Ver</a></td>
        </tr>
    }
    @if (!Model.Reservations.Any()) { <tr><td colspan="7" class="text-center text-muted">Sin reservas.</td></tr> }
    </tbody>
</table>
