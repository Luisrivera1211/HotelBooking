@model List<HotelBooking.Business.DTOs.Guest.GuestDto>
@{ ViewData["Title"] = "Huéspedes"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Huéspedes</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo huésped</a>
</div>
<table class="table table-striped bg-white align-middle">
    <thead><tr><th>Nombre</th><th>Documento</th><th>Correo</th><th>Teléfono</th><th class="text-end">Acciones</th></tr></thead>
    <tbody>
    @foreach (var g in Model)
    {
        <tr>
            <td>@g.FullName</td><td>@g.Document</td><td>@g.Email</td><td>@g.Phone</td>
            <td class="text-end">
                <a asp-action="Details" asp-route-id="@g.Id" class="btn btn-sm btn-outline-dark">Ver reservas</a>
                <a asp-action="Edit" asp-route-id="@g.Id" class="btn btn-sm btn-outline-primary">Editar</a>
            </td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted">No hay huéspedes registrados.</td></tr> }
    </tbody>
</table>
