@model AuditIndexViewModel
@{
    var current = Model.Entity ?? "";
    string Active(string v) => current == v ? "active" : "";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Auditoría</h1>
    <div class="btn-group">
        <a asp-action="Index" class="btn btn-outline-dark @Active("")">Todo</a>
        <a asp-action="Index" asp-route-entity="Reservation" class="btn btn-outline-dark @Active("Reservation")">Reservas</a>
        <a asp-action="Index" asp-route-entity="Room" class="btn btn-outline-dark @Active("Room")">Habitaciones</a>
        <a asp-action="Index" asp-route-entity="Notification" class="btn btn-outline-dark @Active("Notification")">Notificaciones</a>
    </div>
</div>
<p class="text-muted">Últimas operaciones registradas (máximo 200).</p>
<table class="table table-striped table-sm bg-white align-middle">
    <thead>
        <tr><th>Fecha y hora</th><th>Usuario</th><th>Acción</th><th>Entidad</th><th>Detalle</th></tr>
    </thead>
    <tbody>
    @foreach (var a in Model.Logs)
    {
        <tr>
            <td class="text-nowrap">@a.OccurredAt.Local()</td>
            <td>@(a.UserName ?? "(sin sesión)")</td>
            <td>@UiHelpers.AuditAction(a.Action)</td>
            <td>@UiHelpers.AuditEntity(a.EntityName) #@a.EntityId</td>
            <td class="small">@a.Details</td>
        </tr>
    }
    @if (!Model.Logs.Any())
    {
        <tr><td colspan="5" class="text-center text-muted">Aún no hay operaciones registradas.</td></tr>
    }
    </tbody>
</table>
