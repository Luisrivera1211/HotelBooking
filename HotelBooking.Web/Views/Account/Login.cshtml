@model LoginViewModel
@{
    var returnUrl = ViewData["ReturnUrl"]?.ToString();
}
@{
    ViewData["Title"] = "Iniciar sesión";
}
<div class="row justify-content-center auth-wrap">
    <div class="col-md-5">
        <div class="card shadow-sm app-card">
            <div class="card-body">
                <div class="text-center mb-3"><img src="~/img/logo-mark.svg" alt="HotelBooking" width="56" height="56" /></div>
                <h1 class="h4 mb-3 text-center">Iniciar sesión</h1>
                <form asp-action="Login" asp-route-returnUrl="@returnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Correo</label>
                        <input asp-for="Email" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Contraseña</label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Entrar</button>
                </form>
                <p class="mt-3 mb-0 text-center">¿No tiene cuenta? <a asp-action="Register">Regístrese</a></p>
            </div>
        </div>
    </div>
</div>
