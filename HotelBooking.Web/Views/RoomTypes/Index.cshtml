@model List<HotelBooking.Business.DTOs.RoomType.RoomTypeDto>
@{ ViewData["Title"] = "Tipos de habitación"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Tipos de habitación</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo tipo</a>
</div>
<table class="table table-striped bg-white align-middle">
    <thead><tr><th>Nombre</th><th>Capacidad</th><th>Tarifa por noche</th><th class="text-end">Acciones</th></tr></thead>
    <tbody>
    @foreach (var t in Model)
    {
        <tr>
            <td>@t.Name</td>
            <td>@t.Capacity</td>
            <td>@t.RatePerNight.ToDop()</td>
            <td class="text-end"><a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Editar</a></td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="4" class="text-center text-muted">No hay tipos registrados.</td></tr> }
    </tbody>
</table>
