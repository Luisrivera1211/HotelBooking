@model List<HotelBooking.Business.DTOs.Room.RoomDto>
@{
    var floor = (HotelBooking.Business.DTOs.Floor.FloorDto)ViewData["Floor"]!;
    ViewData["Title"] = "Habitaciones";
}
<nav aria-label="breadcrumb"><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-controller="Hotels" asp-action="Index">Hoteles</a></li>
    <li class="breadcrumb-item"><a asp-controller="Floors" asp-action="Index" asp-route-blockId="@floor.BlockId">Pisos</a></li>
    <li class="breadcrumb-item active">Piso @floor.Number</li>
</ol></nav>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Habitaciones del piso @floor.Number</h1>
    @if (floor.IsActive)
    {
        <a asp-action="Create" asp-route-floorId="@floor.Id" class="btn btn-primary">Nueva habitación</a>
    }
    else
    {
        <span class="badge bg-secondary">Piso inactivo: no admite habitaciones nuevas</span>
    }
</div>
<table class="table table-striped bg-white align-middle">
    <thead><tr><th>Número</th><th>Tipo</th><th>Capacidad</th><th>Tarifa</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr>
            <td>@r.Number</td>
            <td>@r.RoomTypeName</td>
            <td>@r.Capacity</td>
            <td>@r.RatePerNight.ToString("C")</td>
            <td><span class="badge bg-@r.Status.Badge()">@r.Status.Text()</span></td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                <form asp-action="ChangeStatus" method="post" class="d-inline-flex gap-1">
                    <input type="hidden" name="id" value="@r.Id" />
                    <input type="hidden" name="floorId" value="@floor.Id" />
                    <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                        @foreach (var s in Enum.GetValues<RoomStatus>())
                        {
                            <option value="@s" selected="@(s == r.Status)">@s.Text()</option>
                        }
                    </select>
                </form>
            </td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted">Este piso no tiene habitaciones.</td></tr> }
    </tbody>
</table>
